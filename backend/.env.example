APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info

# Comma-separated list parsed by pydantic-settings as JSON.
APP_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Relative to backend/ when you run uvicorn from that directory. Reserved for
# when repositories switch from empty fixtures to JSON-backed reads.
APP_DATA_JSON_PATH=data/demo.json
